;; s3 — an S3-compatible object-storage client for Brood (AWS Signature V4).
;; Works with Tigris, AWS S3, MinIO, Cloudflare R2 — anything speaking the S3 API.
;; Pure Brood over http (rustls https); no external deps.
(project
  :name "s3"
  :version "0.2.3"
  :brood ">= 0.4.0"
  :description "An S3-compatible object-storage client (AWS SigV4) for Tigris/AWS/MinIO/R2."
  :repository "https://github.com/broodlang/s3")
